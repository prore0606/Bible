{
  "name": "malsseumsup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "predev": "node scripts/gen-migrations.mjs && node scripts/copy-wasm.mjs",
    "prebuild": "node scripts/gen-migrations.mjs && node -e \"require('fs').rmSync('public/assets/sql-wasm.wasm',{force:true})\"",
    "pretest": "node scripts/gen-migrations.mjs",
    "build:bible": "node scripts/build-bible.mjs",
    "gen:fonts": "node scripts/gen-fonts.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.5.3",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "jeep-sqlite": "^2.8.0",
    "next": "16.4.2",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sql.js": "1.12.0"
  }
}
